
# SonarQube Connection (REQUIRED)
SONARQUBE_SERVER=https://your-sonarqube-enterprise.company.com
SONARQUBE_TOKEN=squ_your_enterprise_token_here
SONARQUBE_VERIFY_SSL=true

# Exporter Settings
EXPORTER_PORT=8198
SCRAPE_INTERVAL=60
REQUEST_TIMEOUT=30

# Rate Limiting (Enterprise 2025: max 600 req/min)
RATE_LIMIT_REQUESTS_PER_MINUTE=500
RATE_LIMIT_DELAY=0.12
RETRY_ATTEMPTS=3
RETRY_BACKOFF_SECONDS=2

# Pagination
MAX_PROJECTS=0
PAGE_SIZE=100
MAX_CONCURRENT_REQUESTS=5

# Enterprise Features
INCLUDE_ENTERPRISE_FEATURES=true
INCLUDE_BRANCHES=true
INCLUDE_APPLICATIONS=true
INCLUDE_PORTFOLIOS=true
INCLUDE_QUALITY_PROFILES=false

# RBAC Integration
ENABLE_RBAC=true
RBAC_CACHE_TTL=300

# Logging
LOG_LEVEL=INFO

# Grafana Settings
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me_in_production

# Optional: SonarQube OAuth for Grafana
ENABLE_SONARQUBE_OAUTH=false
SONARQUBE_OAUTH_CLIENT_ID=
SONARQUBE_OAUTH_CLIENT_SECRET=
